{
    "schemaVersion": 1,
    "id": "general-custom-data",
    "version": "${version}",
    "name": "General Custom Data",
    "description": "Interface injecting API providing data components like functionality for custom data tags.",
    "authors": [
        {
            "name": "CookedSeafood",
            "contact": {
                "homepage": "https://github.com/CookedSeafood"
            }
        }
    ],
    "contact": {
        "homepage": "https://modrinth.com/mod/general-custom-data",
        "sources": "https://github.com/CookedSeafood/general-custom-data",
        "issues": "https://github.com/CookedSeafood/general-custom-data/issues"
    },
    "license": "GNU-GPL-3.0",
    "icon": "assets/general-custom-data/icon.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "net.hederamc.generalcustomdata.GeneralCustomData"
        ],
        "client": [
            "net.hederamc.generalcustomdata.GeneralCustomDataClient"
        ]
    },
    "mixins": [
        "general-custom-data.mixins.json",
        {
            "config": "general-custom-data.client.mixins.json",
            "environment": "client"
        }
    ],
    "depends": {
        "fabricloader": ">=0.18.4",
        "minecraft": "~26.1-",
        "java": ">=25",
        "fabric-api": "*",
        "generic-registry": "~4.0.0-",
        "fishbone-trehalose": "~4.0.0-"
    },
    "suggests": {},
    "custom": {
        "modmenu": {
            "badges": [
                "library"
            ]
        }
    },
    "accessWidener": "general-custom-data.classtweaker"
}